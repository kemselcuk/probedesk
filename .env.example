# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://probedesk:probedesk@127.0.0.1:5432/probedesk?schema=public
# Separate database used by integration tests. The test guard refuses to run
# destructive helpers when this points at the development database.
TEST_DATABASE_URL=postgresql://probedesk:probedesk@127.0.0.1:5433/probedesk_test?schema=public
# Session cookies are only allowed to travel over HTTP in the documented local
# demo. The API refuses to start when NODE_ENV=production and this is not true.
SESSION_COOKIE_SECURE=false
# Trust one proxy hop when resolving the client address used by login
# throttling. Keep false for direct API access; delivery compose enables it
# behind nginx, which overwrites X-Forwarded-For with the direct client IP.
TRUST_PROXY=false

# Playwright comparison test cleanup target (use the test database).
E2E_DATABASE_URL=postgresql://probedesk:probedesk@127.0.0.1:5433/probedesk_e2e_test?schema=public
