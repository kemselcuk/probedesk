generator client {
  provider            = "prisma-client"
  output              = "../src/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Application roles. Exactly one role is assigned to each user.
enum Role {
  PLANNER
  OPERATOR
  VIEWER
}

/// One of the three pre-provisioned accounts. Email comparison is exact and
/// case-sensitive at the database level; authentication normalises input later.
model User {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String         @unique
  passwordHash       String
  role               Role
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  sessions           Session[]
  createdPlans       TestPlan[]
  publishedRevisions PlanRevision[]
  requestedRuns      TestRun[]      @relation("RequestedRuns")
  cancelledRuns      TestRun[]      @relation("CancelledRuns")
  createdDevices     Device[]
  planCopyRequests   PlanCopyRequest[]

  @@map("users")
}

/// Server-side session record. Only token hashes are stored, never raw tokens.
model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash     String    @unique
  userId        String    @db.Uuid
  csrfTokenHash String?
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single simulated device profile; seeded data uses code as its stable key.
model DeviceProfile {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique
  name        String
  description String?
  plans       TestPlan[]
  devices     Device[]

  @@map("device_profiles")
}

/// A durable identity record for a unit tested against the single simulator
/// profile. Archiving replaces deletion, and the canonical serial key keeps
/// uniqueness case-insensitive inside the profile.
model Device {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceProfileId String        @db.Uuid
  name            String
  serialNumber    String
  serialNumberKey String
  description     String?
  archivedAt      DateTime?     @db.Timestamptz(6)
  editRevision    Int           @default(1)
  createdById     String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  deviceProfile   DeviceProfile @relation(fields: [deviceProfileId], references: [id], onDelete: Restrict)
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  runs            TestRun[]

  @@unique([deviceProfileId, serialNumberKey])
  @@index([createdById])
  @@map("devices")
}

/// Immutable plan identity. Names and step rules live in revisions; the plan
/// row only ties a profile to its creator and revisions.
model TestPlan {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceProfileId String         @db.Uuid
  createdById     String         @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  deviceProfile   DeviceProfile  @relation(fields: [deviceProfileId], references: [id], onDelete: Restrict)
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  revisions       PlanRevision[]
  stepIdentities  StepIdentity[]
  runs            TestRun[]
  copyRequests    PlanCopyRequest[]

  @@index([deviceProfileId])
  @@index([createdById])
  @@map("test_plans")
}

enum PlanRevisionState {
  DRAFT
  PUBLISHED
}

/// A draft or a published version. `versionNumber` is assigned only on publish;
/// at most one DRAFT may exist per plan (enforced by a partial unique index in
/// the migration) and published version numbers are unique per plan there too.
model PlanRevision {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String            @db.Uuid
  state           PlanRevisionState
  name            String
  versionNumber   Int?
  editRevision    Int               @default(1)
  baseVersionId   String?           @db.Uuid
  publishedById   String?           @db.Uuid
  publishedAt     DateTime?         @db.Timestamptz(6)
  plan            TestPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  // The composite target proves that the base version belongs to the same
  // plan; a hand-written trigger additionally requires it to be PUBLISHED.
  baseVersion     PlanRevision?     @relation("RevisionLineage", fields: [baseVersionId, planId], references: [id, planId], onDelete: Restrict)
  derivedVersions PlanRevision[]    @relation("RevisionLineage")
  publishedBy     User?             @relation(fields: [publishedById], references: [id], onDelete: Restrict)
  steps           PlanStep[]
  runs            TestRun[]
  copyRequests    PlanCopyRequest[]

  // Composite targets used by the revision/step ownership foreign keys.
  @@unique([id, planId])
  @@index([planId])
  @@index([baseVersionId])
  @@index([publishedById])
  @@map("plan_revisions")
}

/// Idempotency and provenance record for copying a published revision into a
/// new independent plan. The target plan/revision is created in the same
/// transaction as this row.
model PlanCopyRequest {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedById   String       @db.Uuid
  idempotencyKey  String
  requestHash     String
  sourceVersionId String       @db.Uuid
  targetPlanId    String       @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  requestedBy     User         @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  sourceVersion   PlanRevision @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  targetPlan      TestPlan     @relation(fields: [targetPlanId], references: [id], onDelete: Restrict)

  @@unique([requestedById, idempotencyKey])
  @@index([sourceVersionId])
  @@index([targetPlanId])
  @@map("plan_copy_requests")
}

/// Permanent logical identity of a plan step. It belongs to exactly one plan and
/// survives step removal from a draft, so historical runs keep their linkage.
model StepIdentity {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String     @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  plan      TestPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  planSteps PlanStep[]

  @@unique([id, planId])
  @@index([planId])
  @@map("step_identities")
}

/// One step row of a specific revision. `planId` is duplicated deliberately so
/// composite foreign keys prove that the revision and the logical identity
/// belong to the same plan.
model PlanStep {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId    String       @db.Uuid
  planId        String       @db.Uuid
  logicalStepId String       @db.Uuid
  position      Int
  name          String
  unit          String
  minimum       Decimal      @db.Decimal(18, 6)
  maximum       Decimal      @db.Decimal(18, 6)
  sampleCount   Int
  intervalMs    Int
  revision      PlanRevision @relation(fields: [revisionId, planId], references: [id, planId], onDelete: Restrict)
  logicalStep   StepIdentity @relation(fields: [logicalStepId, planId], references: [id, planId], onDelete: Restrict)

  @@unique([revisionId, position])
  @@unique([revisionId, logicalStepId])
  @@index([planId])
  @@index([logicalStepId, planId])
  @@map("plan_steps")
}

/// Run lifecycle. Only RUNNING is active; every other value is terminal.
enum RunStatus {
  RUNNING
  COMPLETED
  CANCELLED
  INTERRUPTED
  ERROR
}

/// Overall and per-step verdict. Null while the result is not final.
enum RunOutcome {
  PASSED
  FAILED
}

/// Deterministic simulator scenario selected when the run starts.
enum RunScenario {
  NORMAL
  FORCED_FAILURE
  RANDOM
}

/// Per-step execution state. NOT_RUN means the step was skipped by cancel or
/// recovery before it ever started.
enum RunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
  INTERRUPTED
  ERROR
  NOT_RUN
}

/// SSE/domain event names. The wire value keeps the documented dotted form.
enum RunEventType {
  RUN_STARTED          @map("run.started")
  STEP_STARTED         @map("step.started")
  MEASUREMENT_RECORDED @map("measurement.recorded")
  STEP_COMPLETED       @map("step.completed")
  RUN_COMPLETED        @map("run.completed")
  RUN_CANCELLED        @map("run.cancelled")
  RUN_INTERRUPTED      @map("run.interrupted")
  RUN_ERRORED          @map("run.errored")
}

/// One execution of a published plan revision. Rule fields are immutable
/// snapshots copied at start so later plan edits cannot change history.
/// At most one row may be RUNNING; that rule is a partial unique index added by
/// the migration because the Prisma schema cannot express it.
model TestRun {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId                String      @db.Uuid
  planRevisionId        String      @db.Uuid
  planNameSnapshot      String
  versionNumberSnapshot Int
  profileSnapshot       Json
  deviceId              String?     @db.Uuid
  deviceSnapshot        Json?
  batchNumber           String?
  batchNumberKey        String?
  status                RunStatus   @default(RUNNING)
  outcome               RunOutcome?
  requestedById         String      @db.Uuid
  scenario              RunScenario
  seed                  BigInt
  errorProbability      Decimal?    @db.Decimal(8, 6)
  failureStepId         String?     @db.Uuid
  simulatorVersion      String
  evaluationVersion     String
  idempotencyKey        String
  requestHash           String
  eventSequence         Int         @default(0)
  expectedSampleCount   Int
  recordedSampleCount   Int         @default(0)
  startedAt             DateTime    @db.Timestamptz(6)
  finishedAt            DateTime?   @db.Timestamptz(6)
  cancelledById         String?     @db.Uuid
  reasonCode            String?

  plan         TestPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  planRevision PlanRevision @relation(fields: [planRevisionId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation("RequestedRuns", fields: [requestedById], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("CancelledRuns", fields: [cancelledById], references: [id], onDelete: Restrict)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  steps        RunStep[]
  events       RunEvent[]

  @@unique([requestedById, idempotencyKey])
  @@index([planId, startedAt, id])
  @@index([startedAt(sort: Desc), id(sort: Desc)])
  @@index([deviceId, startedAt(sort: Desc), id(sort: Desc)])
  @@index([batchNumberKey, startedAt(sort: Desc), id(sort: Desc)])
  @@index([status])
  @@index([planRevisionId])
  @@map("test_runs")
}

/// Rule copy of one published plan step plus its execution counters and
/// summary. The run/position and run/logicalStepId pairs are unique.
model RunStep {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId                   String        @db.Uuid
  logicalStepId           String        @db.Uuid
  position                Int
  name                    String
  unit                    String
  minimum                 Decimal       @db.Decimal(18, 6)
  maximum                 Decimal       @db.Decimal(18, 6)
  sampleCount             Int
  intervalMs              Int
  status                  RunStepStatus @default(PENDING)
  outcome                 RunOutcome?
  recordedCount           Int           @default(0)
  outOfToleranceCount     Int           @default(0)
  firstFailureSampleIndex Int?
  startedAt               DateTime?     @db.Timestamptz(6)
  finishedAt              DateTime?     @db.Timestamptz(6)
  statistics              Json?

  run          TestRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  measurements Measurement[]

  // (id, runId) lets Measurement prove that its runId matches the owning step.
  // The analytics top-failed aggregate also uses the migration-only partial
  // covering index "run_steps_completed_analytics_idx" (Prisma cannot express
  // INCLUDE or the WHERE status = 'COMPLETED' predicate).
  @@unique([runId, position])
  @@unique([runId, logicalStepId])
  @@unique([id, runId])
  @@map("run_steps")
}

/// One recorded sample. The composite foreign key to RunStep is the database
/// guarantee that a measurement cannot name another run than its step.
model Measurement {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String   @db.Uuid
  runStepId         String   @db.Uuid
  sampleIndex       Int
  value             Decimal  @db.Decimal(18, 6)
  isWithinTolerance Boolean
  recordedAt        DateTime @db.Timestamptz(6)
  elapsedMs         Int

  runStep RunStep @relation(fields: [runStepId, runId], references: [id, runId], onDelete: Restrict)

  @@unique([runStepId, sampleIndex])
  @@map("measurements")
}

/// Append-only run event source for SSE replay. Sequence is assigned per run
/// and unique inside that run.
model RunEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String       @db.Uuid
  sequence      Int
  type          RunEventType
  schemaVersion Int          @default(1)
  occurredAt    DateTime     @db.Timestamptz(6)
  payload       Json

  run TestRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, sequence])
  @@map("run_events")
}
