{
  "name": "@probedesk/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "npm run db:generate",
    "start": "nest start",
    "prestart:dev": "npm run db:generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prelint": "npm run db:generate",
    "lint": "oxlint --type-aware src/ test/",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "npm run db:generate",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:db:persistence": "tsx test/scripts/persistence-check.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "tsx test/scripts/migrate-test-database.ts",
    "db:reset:test": "tsx test/scripts/reset-test-database.ts",
    "openapi:emit": "tsx src/common/openapi/emit-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.8.1",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
