          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "List the available simulated device profiles.",
        "tags": [
          "device-profiles"
        ]
      }
    },
    "/api/plans": {
      "post": {
        "operationId": "PlansController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlanDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The plan identity, its profile and the new empty draft revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "The name or profileId is invalid, or the body contains unknown fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "The user is not a Planner or the CSRF token is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": [],
            "csrfToken": []
          }
        ],
        "summary": "Create a plan with an empty draft revision.",
        "tags": [
          "plans"
        ]
      },
      "get": {
        "operationId": "PlansController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Planner responses include the open draft summary. Operator and Viewer responses contain only plans with a published revision and never include a draft key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanListItemDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "List plans using the role-appropriate revision names.",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/{id}": {
      "get": {
        "operationId": "PlansController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Plan id.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Planner responses include the open draft with steps. Operator and Viewer responses include only the latest published revision; a plan without published content is a 404 for them.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanDetailDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "The plan does not exist or is not readable by this role.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Read one plan with role-appropriate revision content.",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/{id}/draft": {
      "put": {
        "operationId": "PlansController_saveDraft",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Plan id.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDraftDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved draft, including the identities created for new steps.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftRevisionDto"
                }
              }
            }
          },
          "400": {
            "description": "A field, limit or logicalStepId is invalid. The request may have unknown fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "The user is not a Planner or the CSRF token is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "The plan does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "expectedRevision is stale or the plan has no open draft. No rows were changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": [],
            "csrfToken": []
          }
        ],
        "summary": "Replace the open draft atomically using optimistic concurrency.",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/{id}/draft/publish": {
      "post": {
        "operationId": "PlansController_publishDraft",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Plan id.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishDraftDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The published revision with its version number, publisher and ordered steps.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedRevisionDto"
                }
              }
            }
          },
          "400": {
            "description": "expectedRevision is missing or invalid, or the stored draft content is not publishable. Nothing was published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "The user is not a Planner or the CSRF token is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "The plan does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "expectedRevision is stale, the plan has no open draft, or the draft changed during the transition. Nothing was published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": [],
            "csrfToken": []
          }
        ],
        "summary": "Publish the open draft atomically as the next version.",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/{id}/drafts": {
      "post": {
        "operationId": "PlansController_createDraft",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Plan id.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The new draft with editRevision 1, baseVersionId and copied steps that keep their logicalStepId values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftRevisionDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "The user is not a Planner or the CSRF token is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "The plan does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "An open draft already exists or the plan has no published version. No draft was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": [],
            "csrfToken": []
          }
        ],
        "summary": "Create a new draft copied from the latest published version.",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plans/{id}/versions": {
      "get": {
        "operationId": "PlansController_listVersions",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Plan id.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
