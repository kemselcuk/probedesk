                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "The plan does not exist or has no published version for this role.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "List published versions for a plan, newest first.",
        "tags": [
          "plans"
        ]
      }
    },
    "/api/plan-versions/{id}": {
      "get": {
        "operationId": "PlanVersionsController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Published plan revision id.",
            "schema": {
              "format": "uuid",
