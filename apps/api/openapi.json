              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedRevisionDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "404": {
            "description": "The version does not exist or is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Read one immutable published plan version with ordered steps.",
        "tags": [
          "plan-versions"
        ]
      }
    },
    "/api/runs": {
      "post": {
        "operationId": "RunsController_start",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated key scoped to the current user. Retrying the same request with this key returns the existing run.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "6b6f0a1e-2b64-4e9d-9b8d-0fbe7e75a0c4",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An earlier run for the same user and Idempotency-Key was replayed. Its current status may already be terminal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStartResponseDto"
                }
              }
            }
          },
          "202": {
            "description": "A new RUNNING run was created with its snapshot, steps and first run.started event. The returned URLs can be opened independently of this request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStartResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The Idempotency-Key header or a body field is missing, unknown or outside the scenario contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "The session is missing, expired or revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "403": {
            "description": "The user is not an Operator or the CSRF token is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "RUN_ALREADY_ACTIVE for another active run (details.activeRunId), or IDEMPOTENCY_CONFLICT when the key was used with a different request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": [],
            "csrfToken": []
          }
        ],
        "summary": "Start a published plan version as the single active run, or replay an idempotent retry.",
        "tags": [
          "runs"
        ]
      }
    }
  },
  "info": {
    "title": "ProbeDesk API",
    "description": "Versioned measurement plans, deterministic simulated runs and run comparison. All routes are served under /api.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes."
    },
    {
      "name": "auth",
      "description": "Session login, logout, current user and CSRF protection."
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "probedesk_session",
        "description": "HttpOnly session cookie. The raw value is never returned in a response body."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN",
        "description": "Session-bound double-submit token. Echo the readable XSRF-TOKEN cookie value on every authenticated mutation."
      }
    },
    "schemas": {
      "ApiFieldErrorDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Dotted field path, array indexes included.",
            "example": "steps.1.maximum"
          },
          "code": {
            "type": "string",
            "example": "INVALID_VALUE"
          },
          "message": {
            "type": "string",
            "example": "maximum must be greater than or equal to minimum"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "DRAFT_CONFLICT",
              "RUN_ALREADY_ACTIVE",
              "IDEMPOTENCY_CONFLICT",
              "RUN_NOT_TERMINAL",
              "COMPARISON_PLAN_MISMATCH",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE"
            ],
            "description": "Stable application error code. This list matches the API contract.",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "The request contains invalid fields."
          },
          "requestId": {
            "type": "string",
            "description": "Correlation id also returned in the X-Request-Id header.",
            "example": "5e4d1f0a-cf62-4d2f-9a36-7f3d32f9a0aa"
          },
          "fieldErrors": {
            "description": "Present when field-level validation failed.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiFieldErrorDto"
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Safe, non-sensitive context for the error."
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "planner@probedesk.local"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 256,
            "example": "********"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0f8d4d1e-2d1a-4c58-a8cf-0b5f5c0d3f11"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "planner@probedesk.local"
          },
          "role": {
            "type": "string",
            "enum": [
              "PLANNER",
              "OPERATOR",
              "VIEWER"
            ],
            "example": "PLANNER"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "DeviceProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "b7c5e4a8-7e3d-4a3f-9c1f-1f1d2c3b4a59"
          },
          "code": {
            "type": "string",
            "example": "DC_POWER_MODULE"
          },
          "name": {
            "type": "string",
            "example": "DC Power Module"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Deterministic simulated DC power module used for local demonstrations."
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "CreatePlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Power rail verification"
          },
          "profileId": {
            "type": "string",
            "format": "uuid",
            "description": "Id returned by GET /api/device-profiles.",
            "example": "b7c5e4a8-7e3d-4a3f-9c1f-1f1d2c3b4a59"
          }
        },
        "required": [
          "name",
          "profileId"
        ]
      },
      "PublishedVersionSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionNumber": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "versionNumber",
          "publishedAt"
        ]
      },
      "PlanStepDto": {
        "type": "object",
        "properties": {
          "logicalStepId": {
            "type": "string",
            "format": "uuid",
            "description": "Permanent logical identity shared by every revision of this plan."
          },
          "position": {
            "type": "number",
            "minimum": 1,
            "description": "Server-assigned 1-based order inside the revision."
          },
          "name": {
            "type": "string",
            "example": "Output voltage"
          },
          "unit": {
            "type": "string",
            "example": "V"
          },
          "minimum": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{6}$",
            "example": "4.750000"
          },
          "maximum": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{6}$",
            "example": "5.250000"
          },
          "sampleCount": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000,
            "example": 100
          },
          "intervalMs": {
            "type": "number",
            "minimum": 100,
            "maximum": 5000,
            "example": 250
          }
        },
        "required": [
          "logicalStepId",
          "position",
          "name",
          "unit",
          "minimum",
          "maximum",
          "sampleCount",
          "intervalMs"
        ]
      },
      "DraftRevisionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "editRevision": {
            "type": "number",
            "minimum": 1,
            "example": 3
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT"
            ],
            "example": "DRAFT"
          },
          "name": {
            "type": "string",
            "example": "Power rail verification"
          },
          "versionNumber": {
            "type": "number",
            "nullable": true,
            "example": null
          },
          "baseVersionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Published revision this draft was copied from, if any."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanStepDto"
            }
          }
        },
        "required": [
          "id",
          "editRevision",
          "planId",
          "state",
          "name",
          "versionNumber",
          "steps"
        ]
      },
      "PublishedRevisionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "planId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "PUBLISHED"
            ],
            "example": "PUBLISHED"
          },
          "name": {
            "type": "string",
            "example": "Power rail verification"
          },
          "versionNumber": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "baseVersionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanStepDto"
            }
          }
        },
        "required": [
          "id",
          "planId",
          "state",
          "name",
          "versionNumber",
          "publishedAt",
          "steps"
        ]
      },
      "PlanDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Draft name for a Planner when a draft exists; latest published name otherwise."
          },
          "profile": {
            "$ref": "#/components/schemas/DeviceProfileDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "latestPublishedVersion": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublishedVersionSummaryDto"
              }
            ]
          },
          "draft": {
            "nullable": true,
            "description": "Open draft with steps. Present only in a Planner response.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/DraftRevisionDto"
              }
            ]
          },
          "published": {
            "nullable": true,
            "description": "Latest published revision with steps, if one exists.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublishedRevisionDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "profile",
          "createdAt",
          "latestPublishedVersion",
          "published"
        ]
      },
      "DraftSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "editRevision": {
            "type": "number",
            "minimum": 1,
            "example": 3
          }
        },
        "required": [
          "id",
          "editRevision"
        ]
      },
      "PlanListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Draft name for a Planner; latest published name for Operator and Viewer."
          },
          "profile": {
            "$ref": "#/components/schemas/DeviceProfileDto"
          },
          "latestPublishedVersion": {
            "nullable": true,
            "description": "Highest published version summary, or null before publish.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PublishedVersionSummaryDto"
              }
            ]
          },
          "draft": {
            "nullable": true,
            "description": "Present only in a Planner response. Operator and Viewer responses omit the key.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/DraftSummaryDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "profile",
          "latestPublishedVersion"
        ]
      },
      "DraftStepDto": {
        "type": "object",
        "properties": {
          "logicalStepId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Existing logical step identity. Omit, send null or send an empty string for a new step; the server creates and returns a new identity."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Output voltage"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "example": "V"
          },
          "minimum": {
            "type": "string",
            "example": "4.750000"
          },
          "maximum": {
            "type": "string",
            "example": "5.250000"
          },
          "sampleCount": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000,
            "example": 100
          },
          "intervalMs": {
            "type": "number",
            "minimum": 100,
            "maximum": 5000,
            "example": 250
          }
        },
        "required": [
          "name",
          "unit",
          "minimum",
          "maximum",
          "sampleCount",
          "intervalMs"
        ]
      },
      "SaveDraftDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Power rail verification"
          },
          "expectedRevision": {
            "type": "number",
            "minimum": 1,
            "description": "Current editRevision from the draft. A mismatch is rejected with DRAFT_CONFLICT and no writes.",
            "example": 1
          },
          "steps": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftStepDto"
            }
          }
        },
        "required": [
          "name",
          "expectedRevision",
          "steps"
        ]
      },
      "PublishDraftDto": {
        "type": "object",
        "properties": {
          "expectedRevision": {
            "type": "number",
            "minimum": 1,
            "description": "Current editRevision of the open draft. A mismatch is rejected with DRAFT_CONFLICT and nothing is published.",
            "example": 3
          }
        },
        "required": [
          "expectedRevision"
        ]
      },
      "PublishedBySummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "planner@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "PLANNER",
              "OPERATOR",
              "VIEWER"
            ],
            "example": "PLANNER"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "PublishedVersionListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionNumber": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string",
            "example": "Power rail verification"
          },
          "publishedBy": {
            "$ref": "#/components/schemas/PublishedBySummaryDto"
          }
        },
        "required": [
          "id",
          "versionNumber",
          "publishedAt",
          "name",
          "publishedBy"
        ]
      },
      "StartRunDto": {
        "type": "object",
        "properties": {
          "planVersionId": {
            "type": "string",
            "format": "uuid",
            "description": "Published plan revision id."
          },
          "scenario": {
            "type": "string",
            "enum": [
              "NORMAL",
              "FORCED_FAILURE",
              "RANDOM"
            ],
            "description": "Deterministic simulator scenario.",
            "example": "NORMAL"
          },
          "seed": {
            "type": "number",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Unsigned 32-bit simulator seed.",
            "example": 123456789
          },
          "failureStepId": {
            "type": "string",
            "format": "uuid",
            "description": "Required for FORCED_FAILURE only: the logicalStepId of the failing step in this published version."
          },
          "errorProbability": {
            "type": "string",
            "description": "Required for RANDOM only: decimal failure probability between 0 and 1 with at most 6 fractional digits.",
            "example": "0.050000"
          }
        },
        "required": [
          "planVersionId",
          "scenario",
          "seed"
        ]
      },
      "RunStartResponseDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "RUNNING",
              "COMPLETED",
              "CANCELLED",
              "INTERRUPTED",
              "ERROR"
            ],
            "example": "RUNNING",
            "description": "RUNNING for a newly created run. A replay returns the stored current status, which may already be terminal."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED"
            ],
            "nullable": true,
            "description": "Overall outcome. Null until a COMPLETED run has a verdict; a terminal replay reports the stored value."
          },
          "snapshotUrl": {
            "type": "string",
            "example": "/api/runs/6b1f9c9e-2a7c-4d8d-9f5f-7d2c4a1b3e6f"
          },
          "eventsUrl": {
            "type": "string",
            "example": "/api/runs/6b1f9c9e-2a7c-4d8d-9f5f-7d2c4a1b3e6f/events"
          }
        },
        "required": [
          "runId",
          "status",
          "outcome",
          "snapshotUrl",
          "eventsUrl"
        ]
      }
    }
  }
}
