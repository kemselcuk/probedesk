{
  "name": "@probedesk/api-client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Generated OpenAPI types for the ProbeDesk API",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
